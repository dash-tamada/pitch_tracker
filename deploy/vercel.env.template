# Environment variables for Vercel (Project → Settings → Environment Variables → "Import .env").
# Fill every value in, save as a file OUTSIDE git, import it, then delete it. Never commit real values.
# Vercel cannot reach localhost: every database URL must point at a hosted Postgres (e.g. Supabase).

# ── App ──
APP_ENV=production
APP_ORIGIN=https://pitch-tracker-iota.vercel.app
TRUST_PROXY=true

# ── Database (hosted Postgres; use the pooled/transaction connection string on Vercel) ──
DATABASE_URL=
PLATFORM_DATABASE_URL=
CREATOR_DATABASE_URL=

# ── Secrets: SESSION_TOKEN_PEPPER and MFA_ENCRYPTION_KEY must be BASE64 of 32 random bytes (not hex). Generate each with:
#    node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#    CRON_SECRET can be any long random string. ──
SESSION_TOKEN_PEPPER=
MFA_ENCRYPTION_KEY=
CRON_SECRET=

# ── File storage (Supabase Storage) ──
SUPABASE_URL=
SUPABASE_SECRET_KEY=
STORAGE_BUCKET=pitch-files
SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_BYTES=52428800

# ── Optional: Google Drive storage instead of Supabase ──
# GOOGLE_DRIVE_ROOT_FOLDER_ID=
# GOOGLE_SERVICE_ACCOUNT_KEY=

# ── Optional: local-only MFA switch. Leave unset in production. ──
# MFA_DISABLED=

# ── Sign in with Google (button appears only when both are set) ──
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: https://pitch-tracker-iota.vercel.app/api/v1/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
