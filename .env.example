# Copy to .env.local for local development. NEVER commit real values.
# Server-only variables — do NOT prefix any of these with NEXT_PUBLIC_.
# Production values go in Vercel → Project → Settings → Environment Variables (Production scope). See docs/DEPLOYMENT.md.

NODE_ENV=development
APP_ENV=development            # development | staging | production  (e2e is used only by the Playwright run)
APP_ORIGIN=http://localhost:3000
# Set to true only behind a proxy you control that appends the client IP (Vercel does). Otherwise leave false.
TRUST_PROXY=false

# ── Database ────────────────────────────────────────────────────────────────
# App runtime role: SELECT/INSERT/UPDATE only, no DDL, INSERT-only on history tables.
# Supabase production: transaction pooler, user "pitch_app.<project-ref>", port 6543. Do not add sslmode — use DATABASE_CA_CERT.
DATABASE_URL=postgres://pitch_app:[PLACEHOLDER_PASSWORD]@localhost:5432/pitch_dev
# Migration role: used only where migrations run (your machine or a CI job), never in the running app.
# Supabase: session pooler (port 5432) as "postgres.<project-ref>", or the direct connection.
MIGRATION_DATABASE_URL=postgres://pitch_migrator:[PLACEHOLDER_PASSWORD]@localhost:5432/pitch_dev
# Supabase root CA (Dashboard → Project Settings → Database → SSL Configuration → Download certificate).
# Paste the PEM text, or base64 of the file on one line. Required for a remote database when APP_ENV is staging/production.
DATABASE_CA_CERT=
# Separate database for integration tests (name must contain "test"; it is dropped and recreated each run)
TEST_DATABASE_URL=postgres://pitch_app:[PLACEHOLDER_PASSWORD]@localhost:5432/pitch_test
TEST_MIGRATION_DATABASE_URL=postgres://pitch_migrator:[PLACEHOLDER_PASSWORD]@localhost:5432/pitch_test

# ── Keys ────────────────────────────────────────────────────────────────────
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_TOKEN_PEPPER=[PLACEHOLDER_RANDOM_32_BYTES_BASE64]
# Encrypts MFA secrets at rest (exactly 32 bytes, base64)
MFA_ENCRYPTION_KEY=[PLACEHOLDER_RANDOM_32_BYTES_BASE64]
# Scheduled jobs: Vercel Cron sends "Authorization: Bearer <CRON_SECRET>". At least 32 characters.
CRON_SECRET=[PLACEHOLDER_RANDOM_AT_LEAST_32_CHARS]

# ── File storage (Supabase Storage, private bucket) ─────────────────────────
# Dashboard → Project Settings → API. The secret key is server-only and bypasses RLS: never expose it.
SUPABASE_URL=https://[PLACEHOLDER_PROJECT_REF].supabase.co
SUPABASE_SECRET_KEY=[PLACEHOLDER]
STORAGE_BUCKET=pitch-files
SIGNED_URL_TTL_SECONDS=60
MAX_UPLOAD_BYTES=52428800
# Local development without Supabase: leave SUPABASE_* empty and set this to 1 to keep files in memory
# (lost on restart). Always refused when APP_ENV is staging or production.
ALLOW_MEMORY_STORAGE=

# ── Not wired yet (reserved) ────────────────────────────────────────────────
# Email: no provider is configured; the app writes "email.logged" events to the server log instead of sending.
# SMTP_URL=
# EMAIL_FROM=
# Error monitoring: not configured.
# SENTRY_DSN=

# ── One-off script inputs (set in the shell for a single command, never saved) ─
# BOOTSTRAP_ADMIN_PASSWORD=   used by npm run admin:create
# DEMO_USER_PASSWORD=         used by npm run db:seed:demo (refused in production)
