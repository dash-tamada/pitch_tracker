# Copy to .env.local for local development. NEVER commit real values.
# Server-only variables — do NOT prefix any of these with NEXT_PUBLIC_.

NODE_ENV=development
APP_ENV=development            # development | staging | production
APP_ORIGIN=http://localhost:3000

# App runtime role: SELECT/INSERT/UPDATE only, no DDL, INSERT-only on history tables
DATABASE_URL=postgres://pitch_app:[PLACEHOLDER_PASSWORD]@localhost:5432/pitch_dev
# Migration role: used by CI/migration job only, never by the running app
MIGRATION_DATABASE_URL=postgres://pitch_migrator:[PLACEHOLDER_PASSWORD]@localhost:5432/pitch_dev
# Separate database for integration tests
TEST_DATABASE_URL=postgres://pitch_app:[PLACEHOLDER_PASSWORD]@localhost:5432/pitch_test
TEST_MIGRATION_DATABASE_URL=postgres://pitch_migrator:[PLACEHOLDER_PASSWORD]@localhost:5432/pitch_test

# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_TOKEN_PEPPER=[PLACEHOLDER_RANDOM_32_BYTES_BASE64]
# Key for encrypting MFA secrets at rest (32 bytes base64)
MFA_ENCRYPTION_KEY=[PLACEHOLDER_RANDOM_32_BYTES_BASE64]

# Private object storage (S3-compatible). Bucket must block all public access.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=ap-south-1
STORAGE_BUCKET=pitch-tracker-dev-private
STORAGE_ACCESS_KEY_ID=[PLACEHOLDER]
STORAGE_SECRET_ACCESS_KEY=[PLACEHOLDER]
SIGNED_URL_TTL_SECONDS=60
MAX_UPLOAD_BYTES=52428800

# Email (notifications never include script contents)
SMTP_URL=[PLACEHOLDER]
EMAIL_FROM=no-reply@example.com

# Observability (PII scrubbing must be enabled)
SENTRY_DSN=
LOG_LEVEL=info
